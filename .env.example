# Import Control Tower Environment Configuration

# Database Configuration (PostgreSQL 18)
POSTGRES_USER=ict_user
POSTGRES_PASSWORD=ict_password
POSTGRES_DB=import_control_tower

# Web Application Port
WEB_PORT=3000

# Backend Configuration (.NET 10 Web API)
ASPNETCORE_ENVIRONMENT=Production

# Identity & Security (Phase 01)
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_32BYTES_LONG
REFRESH_TOKEN_PEPPER=CHANGE_THIS_TO_A_STRONG_RANDOM_PEPPER_KEY

# Seed Admin Account
SEED_ADMIN_EMAIL=admin@controltower.local
SEED_ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_RANDOM_PASSWORD
SEED_ADMIN_FULL_NAME=Initial System Administrator

# Security & CORS Origins
ALLOWED_ORIGINS=http://localhost:3000

# Feature Flags
FINANCIAL_MODULE_ENABLED=false

# Phase 04 — S3 / MinIO Object Storage
STORAGE_PROVIDER=S3
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=import-control-tower-documents
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=CHANGE_THIS_TO_STRONG_STORAGE_SECRET_KEY
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_LIFETIME_MINUTES=15
STORAGE_MAX_UPLOAD_MB=25
